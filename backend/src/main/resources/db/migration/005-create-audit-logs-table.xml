<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-create-audit-logs-table" author="raffo">
        <createTable tableName="audit_logs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="action" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="actor_username" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="entity_type" type="VARCHAR(50)"/>

            <column name="entity_id" type="BIGINT"/>

            <column name="details_json" type="TEXT" defaultValue="{}">
                <constraints nullable="false"/>
            </column>

            <column name="occurred_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="audit_logs" indexName="idx_audit_logs_occurred_at">
            <column name="occurred_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>